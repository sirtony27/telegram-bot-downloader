# Directorio para archivos temporales de descarga
TEMP_DIR=./temp

# Tamaño máximo de archivo permitido por yt-dlp (en MB)
# Telegram admite hasta 50 MB para bots
MAX_FILE_SIZE_MB=50

# Timeout para operaciones de yt-dlp (en milisegundos)
YTDLP_TIMEOUT_MS=120000

# (Opcional) Ruta al archivo de cookies Netscape para YouTube e Instagram
# Exportalo desde Chrome/Firefox con la extensión "Get cookies.txt LOCALLY"
# Luego subilo al servidor y ponés la ruta acá, ej: /home/ubuntu/cookies.txt
# COOKIES_FILE=/home/ubuntu/cookies.txt

# (Opcional) Proxy SOCKS5 para yt-dlp — usar con Cloudflare WARP en modo proxy
# Instalá WARP con: warp-cli set-mode proxy && warp-cli connect
# Solo afecta las descargas, no SSH ni Telegram
# YTDLP_PROXY=socks5h://127.0.0.1:40000
