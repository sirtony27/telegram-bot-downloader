# Token del bot obtenido desde @BotFather en Telegram
TELEGRAM_BOT_TOKEN=123456789:AAAAAA_reemplazar_por_tu_token_real

# Tu Telegram User ID numérico (único número autorizado)
# Para obtenerlo, enviá un mensaje a @userinfobot en Telegram
OWNER_CHAT_ID=123456789


# Directorio para archivos temporales de descarga
TEMP_DIR=./temp

# Tamaño máximo de archivo permitido por yt-dlp (en MB)
# Telegram admite hasta 50 MB para bots
MAX_FILE_SIZE_MB=50

# Timeout para operaciones de yt-dlp (en milisegundos)
YTDLP_TIMEOUT_MS=120000

# Ajustes de rendimiento para descargas (Oracle Free Tier recomendado)
# Fragmentos concurrentes de yt-dlp (equivale a -N)
YTDLP_CONCURRENCY=16
# Tamaño de chunk HTTP en MB (ayuda contra throttling; 0 para desactivar)
YTDLP_HTTP_CHUNK_SIZE_MB=10

# Downloader externo opcional (recomendado: aria2c)
# sudo apt install -y aria2
# YTDLP_EXTERNAL_DOWNLOADER=aria2c
# YTDLP_EXTERNAL_DOWNLOADER_ARGS=-x16 -s16 -k1M --file-allocation=none

# (Opcional) Ruta al archivo de cookies Netscape para YouTube e Instagram
# Exportalo desde Chrome/Firefox con la extensión "Get cookies.txt LOCALLY"
# Luego subilo al servidor y ponés la ruta acá, ej: /home/ubuntu/cookies.txt
# COOKIES_FILE=/home/ubuntu/cookies.txt

# (Opcional) Proxy SOCKS5 para yt-dlp — usar con Cloudflare WARP en modo proxy
# Instalá WARP con: warp-cli set-mode proxy && warp-cli connect
# Solo afecta las descargas, no SSH ni Telegram
# YTDLP_PROXY=socks5h://127.0.0.1:40000

# ── Servidor Web (PWA) ────────────────────────────────────────────────────
# Puerto del servidor web
WEB_PORT=3000

# URL base pública del servidor (cambiar por la IP del servidor en producción)
# Si usás DuckDNS + reverse proxy HTTPS: https://tu-subdominio.duckdns.org
# Si lo dejás vacío, el servidor deduce host/protocolo automáticamente.
WEB_BASE_URL=https://tu-subdominio.duckdns.org
